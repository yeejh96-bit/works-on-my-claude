# Claude Code 개인용 로컬 설정 (공유 안 함)
.claude/settings.local.json


# ─────────────────────────────────────────────
# 아래는 예방용이다 — 지금 이 저장소에는 해당하는 폴더·파일이 하나도 없다.
# (서드파티 의존성 0개, 빌드 과정 없음.) 나중에 도구를 붙였을 때
# 실수로 올라가는 것을 미리 막아 둔다.
# ─────────────────────────────────────────────

# 의존성 설치물
node_modules/

# 파이썬 (실행 캐시 · 가상환경)
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# 환경변수 / 비밀키 (견본 .env.example 은 비밀이 없어 공유해도 안전 → 예외)
.env
.env.*
!.env.example

# 빌드 산출물
dist/
build/
out/

# 캐시
.cache/

# 로그
*.log

# OS / 에디터
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
