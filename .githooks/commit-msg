#!/bin/sh
# 커밋 메시지에서 셸 따옴표 잔재(@ 한 줄)를 걷어낸다.
#
# 왜 필요한가:
#   PowerShell 의 여러 줄 문자열은 @'...'@ 로 감싼다. 이 문법을 Bash(POSIX sh)에서 쓰면
#   Bash 는 @ 를 문자열의 일부로 취급해, 커밋 메시지 첫 줄·마지막 줄에 @ 만 있는 줄이 남는다.
#   그러면 제목이 "@ feat: ..." 처럼 깨져 커밋을 다시 하게 된다(같은 작업 두 번).
#   이 훅은 그 잔재를 지워 커밋이 한 번에 끝나게 한다.
#
# 하는 일: 내용이 @ · @' · '@ 뿐인 줄을 지운다. (커밋 메시지에서 그런 줄은 의미가 없다.)
# 이 훅을 켜려면 저장소에서 한 번:  git config core.hooksPath .githooks

msg_file="$1"
[ -f "$msg_file" ] || exit 0

cleaned="$msg_file.womc-clean"
sed -E "/^[[:space:]]*(@|@'|'@)[[:space:]]*$/d" "$msg_file" > "$cleaned" || exit 0

if cmp -s "$msg_file" "$cleaned"; then
  rm -f "$cleaned"
  exit 0
fi

mv -f "$cleaned" "$msg_file"
echo "[commit-msg] 커밋 메시지에서 셸 따옴표 잔재(@ 만 있는 줄)를 지웠습니다."
echo "             원인: PowerShell 문법 @'...'@ 를 Bash 에서 쓴 것. 여러 줄 메시지는 파일에 쓰고 git commit -F <파일> 로 넣으세요."
exit 0
